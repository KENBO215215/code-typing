    async Task LoadPresets()
    {
        var added = 0;
        foreach (var p in PresetSentences)
        {
            if (!pairs.Any(x => x.Japanese == p.Japanese))
            {
                pairs.Add(new SentencePair { Japanese = p.Japanese, Reading = p.Reading, English = p.English });
                added++;
            }
        }
        if (added > 0) { studyPairs = new(pairs); await Save(); }
    }

