    // ── Lifecycle ──────────────────────────────────────────
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", "ll_pairs_v1");
            if (!string.IsNullOrEmpty(json))
            {
                pairs = JsonSerializer.Deserialize<List<SentencePair>>(json) ?? new();
                studyPairs = new(pairs);
                StateHasChanged();
            }
        }
        catch { }
    }

    async Task Save()
    {
        var json = JsonSerializer.Serialize(pairs);
        await JS.InvokeVoidAsync("localStorage.setItem", "ll_pairs_v1", json);
    }

    // ── 例文追加 ────────────────────────────────────────────
    List<string> AllGroups => pairs.Select(p => p.Group).Where(g => !string.IsNullOrWhiteSpace(g))
                                   .Distinct().OrderBy(g => g).ToList();

    List<SentencePair> ActivePairs => string.IsNullOrEmpty(selectedGroup)
        ? pairs : pairs.Where(p => p.Group == selectedGroup).ToList();

    void ChangeGroup(string g)
    {
        selectedGroup = g; studyIdx = 0; typeIdx = 0;
        studyPairs = new(ActivePairs); ClearCloze();
    }

    async Task AddPair()
    {
        if (string.IsNullOrWhiteSpace(addJa) && string.IsNullOrWhiteSpace(addEn)) return;
        pairs.Add(new SentencePair { Japanese = addJa.Trim(), Reading = addReading.Trim(),
                                     English = addEn.Trim(), Group = addGroup.Trim() });
        studyPairs = new(ActivePairs);
        addJa = ""; addReading = ""; addEn = "";
        await Save();
    }

    async Task DeletePair(int i)
    {
        pairs.RemoveAt(i);
        studyPairs = new(pairs);
        if (studyIdx >= studyPairs.Count) studyIdx = Math.Max(0, studyPairs.Count - 1);
        await Save();
    }

    async Task OnAddKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddPair();
    }

    // ── 学習 ────────────────────────────────────────────────
    void StudyPrev() { if (studyIdx > 0) { studyIdx--; ClearCloze(); } }
    void StudyNext() { if (studyIdx < studyPairs.Count - 1) { studyIdx++; ClearCloze(); } }

    void Shuffle()
    {
        studyPairs = studyPairs.OrderBy(_ => Random.Shared.Next()).ToList();
        studyIdx = 0; ClearCloze();
    }

    void DoCloze()
    {
        var p = studyPairs[studyIdx];
        clozeJa = RandomHide(SmartSplit(p.Japanese).Length, clozePercent);
        clozeEn = RandomHide(SmartSplit(p.English).Length, clozePercent);
    }

    void ClearCloze() { clozeJa.Clear(); clozeEn.Clear(); }

    static string[] SmartSplit(string text)
    {
        if (string.IsNullOrEmpty(text)) return [];
        var bySpace = text.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (bySpace.Length > 1) return bySpace;
        // スペースなし（日本語等）: 3文字ずつ分割
        var chunks = new List<string>();
        for (int i = 0; i < text.Length; i += 3)
            chunks.Add(text.Substring(i, Math.Min(3, text.Length - i)));
        return chunks.ToArray();
    }

    static HashSet<int> RandomHide(int n, int percent)
    {
        if (n <= 1) return new();
        var take = Math.Min(n - 1, (int)Math.Floor(n * percent / 100.0));
        return new HashSet<int>(Enumerable.Range(0, n).OrderBy(_ => Random.Shared.Next()).Take(take));
    }

    IEnumerable<WordItem> SplitWords(string text, HashSet<int> hidden)
        => SmartSplit(text).Select((w, i) => new WordItem(w, i, hidden.Contains(i)));

    // ── タイピング ──────────────────────────────────────────
    void PrevPair() { if (typeIdx > 0) { typeIdx--; ResetType(); } }
    void NextPair() { if (typeIdx < ActivePairs.Count - 1) { typeIdx++; ResetType(); } }
    void JumpType(ChangeEventArgs e)  { typeIdx  = int.TryParse(e.Value?.ToString(), out var v) ? v : 0; ResetType(); }
    void JumpStudy(ChangeEventArgs e) { studyIdx = int.TryParse(e.Value?.ToString(), out var v) ? v : 0; ClearCloze(); }
    void ResetType() { typeInput = ""; }

    string TypePlaceholder() => typeTarget switch
    {
        "en"     => "Type in English...",
        "ja_raw" => "日本語で入力（IME使用）...",
        _        => "ローマ字で入力... (e.g. watashi wa)"
    };

    // ── 文法 ────────────────────────────────────────────────
    record GrammarExample(string Japanese, string Reading, string English);
    record GrammarPoint(string Pattern, string MeaningJa, string MeaningEn, GrammarExample[] Examples);

    HashSet<int> openGrammar = new();
    void ToggleGrammar(int i) { if (!openGrammar.Remove(i)) openGrammar.Add(i); }

    async Task AddFromGrammar(GrammarExample ex)
    {
        if (pairs.Any(p => p.Japanese == ex.Japanese)) return;
        pairs.Add(new SentencePair { Japanese = ex.Japanese, Reading = ex.Reading, English = ex.English });
        studyPairs = new(pairs);
        await Save();
    }

