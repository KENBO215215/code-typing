	// DisplayCode is defined above with optional override (_displayOverride)

	IEnumerable<string> CurrentExplanations => Snippets[SelectedId].Explanations;

	IEnumerable<string> GetLineExplanations()
	{
		var code = DisplayCode.Replace("\r\n","\n");
		var lines = code.Split('\n');
		var explains = new List<string>();
		var baseEx = Snippets[SelectedId].Explanations;
		for (int i=0;i<lines.Length;i++)
		{
			if (i < baseEx.Length) explains.Add(baseEx[i]);
			else explains.Add(string.Empty);
		}
		return explains;
	}

	int TotalTyped => Typed?.Length ?? 0;
	int CorrectChars => ComputeCorrect();
	string Accuracy => TotalTyped == 0 ? "0" : ((double)CorrectChars / TotalTyped * 100).ToString("F1");

	// Selection handled by property setters

	int ComputeCorrect()
	{
		if (string.IsNullOrEmpty(Typed) || string.IsNullOrEmpty(DisplayCode)) return 0;
		int cnt = 0;
		var target = DisplayCode.Replace("\r\n","\n");
		for (int i=0;i<Math.Min(target.Length, Typed.Length); i++) if (target[i]==Typed[i]) cnt++;
		return cnt;
	}

	string RenderComparison()
	{
		var target = DisplayCode.Replace("\r\n","\n");
		var sb = new StringBuilder();
		int len = Math.Max(target.Length, Typed.Length);
		for (int i=0;i<len;i++)
		{
			char tc = i < target.Length ? target[i] : '\0';
			char uc = i < Typed.Length ? Typed[i] : '\0';
			if (i < Typed.Length)
			{
				var c = System.Net.WebUtility.HtmlEncode(uc.ToString());
				if (i < target.Length && uc==tc)
				{
					// inline style to avoid scoped-CSS mismatch
					sb.Append($"<span style=\"color:{OkColor};opacity:0.75;\">{c}</span>");
				}
				else
				{
					sb.Append($"<span style=\"color:{NgColor};opacity:0.75;\">{c}</span>");
				}
			}
			else
			{
				// show target remainder as muted
				if (i < target.Length)
				{
					var c = System.Net.WebUtility.HtmlEncode(tc.ToString());
					sb.Append($"<span style=\"color:{RemainColor};opacity:0.45;\">{c}</span>");
				}
			}
		}
		return sb.ToString();
	}
