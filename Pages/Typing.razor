@code {
	private int selectedId = 1;
	public int SelectedId { get => selectedId; set { selectedId = value; ResetTyping(); } }
	private int selectedLang = 1;
	public int SelectedLang { get => selectedLang; set { selectedLang = value; ResetTyping(); } }

	string _typed = string.Empty;
	string Typed
	{
		get => _typed;
		set
		{
			if (_typed.Length == 0 && value.Length > 0) startTime = DateTime.Now;
			_typed = value;
			_ = UpdateScoreAsync();
		}
	}

	string OkColor { get; set; } = "#2e7d32";
	string NgColor { get; set; } = "#c62828";
	string RemainColor { get; set; } = "#777777";
	string SampleText { get; set; } = string.Empty;
	bool RequireTyping { get; set; } = false;

	// ── Score & Timer ──
	DateTime? startTime;
	int HiScore;
	bool IsNewRecord;

	double ElapsedSeconds => startTime.HasValue ? (DateTime.Now - startTime.Value).TotalSeconds : 0;
	string Wpm => ElapsedSeconds > 1 ? ((int)((CorrectChars / 5.0) / (ElapsedSeconds / 60.0))).ToString() : "–";
	bool IsComplete => _typed.Length > 0 && _typed.Replace("\r\n","\n") == DisplayCode.Replace("\r\n","\n");

	int Score
	{
		get
		{
			if (TotalTyped == 0) return 0;
			double acc = (double)CorrectChars / TotalTyped;
			double prog = (double)CorrectChars / Math.Max(1, DisplayCode.Length);
			double wpmVal = ElapsedSeconds > 1 ? (CorrectChars / 5.0) / (ElapsedSeconds / 60.0) : 0;
			return (int)(CorrectChars * acc * 10 + wpmVal * 3 + (IsComplete ? 200 : 0));
		}
	}

	async Task UpdateScoreAsync()
	{
		if (TotalTyped == 0) return;
		var key = $"{selectedId}_{selectedLang}";
		bool newRec = await JS.InvokeAsync<bool>("setHiScore", key, Score);
		if (newRec)
		{
			HiScore = Score;
			IsNewRecord = true;
			StateHasChanged();
		}
	}

	async Task LoadHiScoreAsync()
	{
		var key = $"{selectedId}_{selectedLang}";
		HiScore = await JS.InvokeAsync<int>("getHiScore", key);
		IsNewRecord = false;
		StateHasChanged();
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender) await LoadHiScoreAsync();
	}

	void ResetTyping()
	{
		_typed = string.Empty;
		startTime = null;
		IsNewRecord = false;
		_ = LoadHiScoreAsync();
	}

	class Snippet
	{
		public string Title { get; set; }
		public string CSharp { get; set; }
		public string Python { get; set; }
		public string[] Explanations { get; set; }
	}

	void ApplySample()
	{
		if (!string.IsNullOrEmpty(SampleText))
		{
			_displayOverride = SampleText.Replace("\r\n","\n");
			ResetTyping();
		}
	}

	void ClearSample()
	{
		_displayOverride = null;
		SampleText = string.Empty;
		ResetTyping();
	}

	private string? _displayOverride = null;

	string DisplayCode => _displayOverride ?? (SelectedLang == 1 ? Snippets[SelectedId].CSharp
						: SelectedLang == 2 ? Snippets[SelectedId].Python
						: string.Join("\n", Snippets[SelectedId].Explanations));

	Dictionary<int, Snippet> Snippets = new Dictionary<int, Snippet>
	{
		[1] = new Snippet
		{
			Title = "Binary Search",
			CSharp = "int BinarySearch(int[] a, int target)\n{\n    int left = 0, right = a.Length - 1;\n    while (left <= right)\n    {\n        int mid = left + (right - left) / 2;\n        if (a[mid] == target) return mid;\n        if (a[mid] < target) left = mid + 1;\n        else right = mid - 1;\n    }\n    return -1;\n}",
			Python = "def binary_search(a, target):\n    left, right = 0, len(a)-1\n    while left <= right:\n        mid = (left + right)//2\n        if a[mid] == target:\n            return mid\n        if a[mid] < target:\n            left = mid + 1\n        else:\n            right = mid - 1\n    return -1",
			Explanations = new[] {
				"関数宣言: 配列 a と検索対象 target を受け取る",
				"関数本体の開始",
				"探索範囲の左端と右端を初期化",
				"while ループ: 範囲に要素が残る間継続",
				"ループ本体開始",
				"中間位置 mid を計算 (オーバーフロー対策で差分から計算)",
				"見つかった場合はそのインデックスを返す",
				"中間値より小さければ左側を右に移動",
				"そうでなければ右側を左に移動",
				"ループ終了",
				"見つからなければ -1 を返す",
				"関数終了"
			}
		},

		[11] = new Snippet
		{
			Title = "Stack Push (LIFO)",
			CSharp = "void Push(int value)\n{\n    if (top >= MAX_SIZE - 1) { /* overflow */ }\n    else { top = top + 1; stack[top] = value; }\n}",
			Python = "def push(stack, value, top, MAX_SIZE):\n    if top >= MAX_SIZE - 1:\n        raise Exception('overflow')\n    else:\n        top += 1\n        stack[top] = value\n    return top",
			Explanations = new[] {
				"スタックの上位置 top を確認し容量超過ならエラー",
				"そうでなければ top を1つ増やして値を格納",
			}
		},

		[12] = new Snippet
		{
			Title = "Queue Dequeue (Ring Buffer)",
			CSharp = "int Dequeue()\n{\n    if (head == tail) { /* empty */ return -1; }\n    else { var value = queue[head]; head = (head + 1) % MAX_SIZE; return value; }\n}",
			Python = "def dequeue(queue, head, tail, MAX_SIZE):\n    if head == tail:\n        raise Exception('empty')\n    else:\n        value = queue[head]\n        head = (head + 1) % MAX_SIZE\n        return value, head",
			Explanations = new[] {
				"head と tail が等しければキューは空",
				"先頭要素を取り出して head を循環インクリメント",
			}
		},

		[13] = new Snippet
		{
			Title = "Linked List Traversal",
			CSharp = "void Traverse(int start)\n{\n    int p = start;\n    while (p != NIL) { /* process node[p].value */ p = node[p].next; }\n}",
			Python = "def traverse(start):\n    p = start\n    while p is not None:\n        # process node[p].value\n        p = node[p].next",
			Explanations = new[] {
				"始点 start を p にセット",
				"p が空ポインタでない間 node[p] を処理し次へ移動",
			}
		},

		[14] = new Snippet
		{
			Title = "Linear Search",
			CSharp = "int LinearSearch(int[] a, int target)\n{\n    for (int i = 0; i < a.Length; i++) if (a[i] == target) return i; return -1;\n}",
			Python = "def linear_search(a, target):\n    for i in range(len(a)):\n        if a[i] == target:\n            return i\n    return -1",
			Explanations = new[] {
				"先頭から順に target と比較",
				"見つかればインデックスを返す、見つからなければ -1",
			}
		},

		[15] = new Snippet
		{
			Title = "Binary Search (sorted)",
			CSharp = "int BinarySearch(int[] a, int target)\n{\n    int low = 0, high = a.Length - 1;\n    while (low <= high) { int mid = (low + high) / 2; if (a[mid] == target) return mid; else if (a[mid] < target) low = mid + 1; else high = mid - 1; } return -1;\n}",
			Python = "def binary_search(a, target):\n    low, high = 0, len(a)-1\n    while low <= high:\n        mid = (low + high)//2\n        if a[mid] == target: return mid\n        elif a[mid] < target: low = mid + 1\n        else: high = mid - 1\n    return -1",
			Explanations = new[] {
				"low と high で探索範囲を管理",
				"mid を計算して比較し範囲を半分に絞る",
				"見つかればインデックス、なければ -1",
			}
		},

		[16] = new Snippet
		{
			Title = "Hash Search (Open Addressing)",
			CSharp = "int HashSearch(int[] table, int key)\n{\n    int n = table.Length; int h = key % n; int i = 0;\n    while (table[(h + i) % n] != EMPTY) { if (table[(h + i) % n] == key) return (h + i) % n; i++; }\n    return -1;\n}",
			Python = "def hash_search(table, key):\n    n = len(table)\n    h = key % n\n    i = 0\n    while table[(h + i) % n] is not None:\n        if table[(h + i) % n] == key:\n            return (h + i) % n\n        i += 1\n    return -1",
			Explanations = new[] {
				"初期ハッシュ h を計算",
				"衝突時は線形探索で次のスロットを調べる",
				"空スロットなら見つからないと判断",
			}
		},

		[17] = new Snippet
		{
			Title = "GCD (Euclid, recursive)",
			CSharp = "int Gcd(int x, int y) { if (y == 0) return x; else return Gcd(y, x % y); }",
			Python = "def gcd(x, y):\n    if y == 0:\n        return x\n    else:\n        return gcd(y, x % y)",
			Explanations = new[] {
				"y が0なら x が最大公約数",
				"そうでなければ再帰的に gcd(y, x mod y)",
			}
		},

		[18] = new Snippet
		{
			Title = "Brute-force String Search",
			CSharp = "int StrSearch(string text, string pat)\n{\n    for (int i = 0; i <= text.Length - pat.Length; i++) { int j = 0; while (j < pat.Length && text[i + j] == pat[j]) j++; if (j == pat.Length) return i; } return -1;\n}",
			Python = "def str_search(text, pat):\n    for i in range(len(text) - len(pat) + 1):\n        j = 0\n        while j < len(pat) and text[i+j] == pat[j]:\n            j += 1\n        if j == len(pat):\n            return i\n    return -1",
			Explanations = new[] {
				"テキストの各開始位置でパターンと比較（力まかせ）",
				"一致すれば開始位置を返す、なければ -1",
			}
		},

		[2] = new Snippet
		{
			Title = "Merge Sort",
			CSharp = "void MergeSort<T>(T[] a) where T : IComparable<T>\n{ /* ... */ }",
			Python = "def merge_sort(a):\n    # ...\n    return a",
			Explanations = new[] {
				"関数宣言: ジェネリックな配列を受け取りソートする(型は比較可能であること)",
				"関数本体: 再帰的に配列を分割してマージする実装の省略部",
			}
		},

		[3] = new Snippet
		{
			Title = "Quick Sort",
			CSharp = "void QuickSort(int[] a,int lo,int hi) { /* ... */ }",
			Python = "def quicksort(a, lo, hi):\n    # ...",
			Explanations = new[] {
				"関数宣言: 配列と範囲を受け取りクイックソートを実行",
				"関数本体はピボットで分割して再帰的にソートする（省略）",
			}
		},

		[4] = new Snippet
		{
			Title = "Bubble Sort",
			CSharp = "void BubbleSort(int[] a)\n{\n    for (int i = 0; i < a.Length; i++)\n        for (int j = 0; j + 1 < a.Length - i; j++)\n            if (a[j] > a[j+1]) { var t = a[j]; a[j]=a[j+1]; a[j+1]=t; }\n}",
			Python = "def bubble_sort(a):\n    n = len(a)\n    for i in range(n):\n        for j in range(0, n-i-1):\n            if a[j] > a[j+1]:\n                a[j], a[j+1] = a[j+1], a[j]",
			Explanations = new[] {
