@page "/typing"
@using System.Text
@inject IJSRuntime JS

<div class="page-header">
    <h2 class="page-title">⌨️ Code Typing Practice <span class="page-version">v1.3</span></h2>
    @if (IsComplete)
    {
        <div class="complete-badge">✅ Complete!</div>
    }
</div>

<div class="typing-container" style="--ok-color:@OkColor; --ng-color:@NgColor; --remain-color:@RemainColor;">
	<div class="left">
		<div class="controls">
            <div class="ctrl-row">
                <div class="ctrl-group">
                    <label class="ctrl-label">Algorithm</label>
                    <select @bind="SelectedId">
                        <optgroup label="アルゴリズム">
                            @foreach(var kv in Snippets.Where(x => x.Key < 19))
                            {
                                <option value="@kv.Key">@kv.Value.Title</option>
                            }
                        </optgroup>
                        <optgroup label="基本情報 科目B (FE試験) 疑似言語">
                            @foreach(var kv in Snippets.Where(x => x.Key >= 19))
                            {
                                <option value="@kv.Key">@kv.Value.Title</option>
                            }
                        </optgroup>
                    </select>
                </div>
                <div class="ctrl-group">
                    <label class="ctrl-label">Language</label>
                    <select @bind="SelectedLang">
                        <option value="1">C# / 疑似言語</option>
                        <option value="2">Python</option>
                        <option value="3">解説メモ</option>
                    </select>
                </div>
                <button class="reset-btn" @onclick="ResetTyping" title="Reset">↺ Reset</button>
            </div>
            <div class="ctrl-row ctrl-row--colors">
                <label>✅ <input type="color" @bind="OkColor" /></label>
                <label>❌ <input type="color" @bind="NgColor" /></label>
                <label>… <input type="color" @bind="RemainColor" /></label>
                <label class="guide-range">
                    ガイド <input type="range" min="0.1" max="1.0" step="0.05" @bind="GuideOpacity" @bind:event="oninput" /> <span class="guide-pct">@((int)(GuideOpacity * 100))%</span>
                </label>
                <label class="skip-toggle">
                    <input type="checkbox" @bind="SkipComments" @bind:after="ResetTyping" />
                    <span>コメントスキップ</span>
                </label>
            </div>
		</div>

		@if (!string.IsNullOrEmpty(Snippets[SelectedId].Description))
		{
			<div class="algo-desc">@Snippets[SelectedId].Description</div>
		}
		<div class="code-block">
			<pre>@((MarkupString)RenderDisplayCode())</pre>
		</div>

		<div class="sample-box">
            <div class="sample-header" @onclick="() => sampleOpen = !sampleOpen">
                <span>📋 カスタムコードを貼り付け</span>
                <span class="sample-chevron">@(sampleOpen ? "▲" : "▼")</span>
            </div>
            @if (sampleOpen)
            {
                <div class="sample-body">
                    <textarea @bind="SampleText" rows="7" placeholder="コードをここに貼り付け...&#10;（Ctrl+V で貼り付け後「使用する」を押す）" spellcheck="false" autocomplete="off"></textarea>
                    <div class="sample-actions">
                        <button @onclick="ApplySample">✓ 使用する</button>
                        <button @onclick="ClearSample">✕ クリア</button>
                    </div>
                </div>
            }
		</div>
	</div>

	<div class="right">
		<div id="type-window" class="type-window">
			<div class="drag-handle"><span>⌨️ TYPE</span><span class="drag-hint">drag</span></div>
			<div class="type-area" style="position:relative;">
				<pre id="overlay" class="overlay">@((MarkupString)RenderComparison())</pre>
				<textarea id="type-textarea" @bind="Typed" @bind:event="oninput" rows="15" placeholder="Type the code here..." spellcheck="false" autocapitalize="off" autocomplete="off"></textarea>
			</div>
		</div>

		<!-- On-screen keyboard: highlights keys while typing -->
		<div class="on-screen-keyboard" id="onScreenKeyboard" aria-hidden="false">
			<div class="osk-row">
				<div class="key" data-key="Esc">Esc</div>
				<div class="key" data-key="F1">F1</div>
				<div class="key" data-key="F2">F2</div>
				<div class="key" data-key="F3">F3</div>
				<div class="key" data-key="F4">F4</div>
			</div>
			<div class="osk-row">
				<div class="key special" data-key="Backquote">`</div>
				<div class="key" data-key="1">1</div>
				<div class="key" data-key="2">2</div>
				<div class="key" data-key="3">3</div>
				<div class="key" data-key="4">4</div>
				<div class="key" data-key="5">5</div>
				<div class="key" data-key="6">6</div>
				<div class="key" data-key="7">7</div>
				<div class="key" data-key="8">8</div>
				<div class="key" data-key="9">9</div>
				<div class="key" data-key="0">0</div>
				<div class="key" data-key="-">-</div>
				<div class="key" data-key="=">=</div>
				<div class="key wide" data-key="Backspace">Backspace</div>
			</div>
			<div class="osk-row">
				<div class="key wide" data-key="Tab">Tab</div>
				<div class="key" data-key="q">Q</div>
				<div class="key" data-key="w">W</div>
				<div class="key" data-key="e">E</div>
				<div class="key" data-key="r">R</div>
				<div class="key" data-key="t">T</div>
				<div class="key" data-key="y">Y</div>
				<div class="key" data-key="u">U</div>
				<div class="key" data-key="i">I</div>
				<div class="key" data-key="o">O</div>
				<div class="key" data-key="p">P</div>
				<div class="key" data-key="[">[</div>
				<div class="key" data-key="]">]</div>
				<div class="key" data-key="\\">\</div>
			</div>
			<div class="osk-row">
				<div class="key wide" data-key="CapsLock">Caps</div>
				<div class="key" data-key="a">A</div>
				<div class="key" data-key="s">S</div>
				<div class="key" data-key="d">D</div>
				<div class="key" data-key="f">F</div>
				<div class="key" data-key="g">G</div>
				<div class="key" data-key="h">H</div>
				<div class="key" data-key="j">J</div>
				<div class="key" data-key="k">K</div>
				<div class="key" data-key="l">L</div>
				<div class="key" data-key=";">;</div>
				<div class="key" data-key="'">'</div>
				<div class="key wide" data-key="Enter">Enter</div>
			</div>
			<div class="osk-row">
				<div class="key wide" data-key="Shift">Shift</div>
				<div class="key" data-key="z">Z</div>
				<div class="key" data-key="x">X</div>
				<div class="key" data-key="c">C</div>
				<div class="key" data-key="v">V</div>
				<div class="key" data-key="b">B</div>
				<div class="key" data-key="n">N</div>
				<div class="key" data-key="m">M</div>
				<div class="key" data-key=",">,</div>
				<div class="key" data-key=".">.</div>
				<div class="key" data-key="/">/</div>
				<div class="key wide" data-key="ShiftRight">Shift</div>
			</div>
			<div class="osk-row">
				<div class="key" data-key="Control">Ctrl</div>
				<div class="key" data-key="Meta">Win</div>
				<div class="key" data-key="Alt">Alt</div>
				<div class="key extra wide" data-key="Space">Space</div>
				<div class="key" data-key="AltRight">Alt</div>
				<div class="key" data-key="ContextMenu">Menu</div>
				<div class="key" data-key="ControlRight">Ctrl</div>
			</div>
		</div>

		<div class="live">
			<div class="live-header">Live compare:</div>
			<pre class="live-compare">@((MarkupString)RenderComparison())</pre>
		</div>

		<div class="stats">
            <div class="stat-card stat-card--score">
                <div class="stat-val">@Score</div>
                <div class="stat-lbl">Score</div>
                @if (IsNewRecord)
                {
                    <div class="new-record">🏆 NEW!</div>
                }
            </div>
            <div class="stat-card">
                <div class="stat-val">@Accuracy<span class="stat-unit">%</span></div>
                <div class="stat-lbl">Accuracy</div>
            </div>
            <div class="stat-card">
                <div class="stat-val">@Wpm<span class="stat-unit">wpm</span></div>
                <div class="stat-lbl">WPM</div>
            </div>
            <div class="stat-card">
                <div class="stat-val">@CorrectChars</div>
                <div class="stat-lbl">Correct</div>
            </div>
            <div class="stat-card stat-card--hi">
                <div class="stat-val">@HiScore</div>
                <div class="stat-lbl">Best</div>
            </div>
		</div>
	</div>
</div>

@code {
	private int selectedId = 1;
	public int SelectedId { get => selectedId; set { selectedId = value; ResetTyping(); } }
	private int selectedLang = 1;
	public int SelectedLang { get => selectedLang; set { selectedLang = value; ResetTyping(); } }

	string _typed = string.Empty;
	string Typed
	{
		get => _typed;
		set
		{
			if (_typed.Length == 0 && value.Length > 0) startTime = DateTime.Now;
			_typed = value;
			_ = UpdateScoreAsync();
		}
	}

	string OkColor { get; set; } = "#a6e3a1";
	string NgColor { get; set; } = "#f38ba8";
	string RemainColor { get; set; } = "#585b70";
	double GuideOpacity { get; set; } = 0.72;
	string SampleText { get; set; } = string.Empty;
	bool SkipComments { get; set; } = false;
	bool sampleOpen = false;

	bool IsCommentLine(string line) =>
		selectedLang == 1 ? line.TrimStart().StartsWith("//") :
		selectedLang == 2 ? line.TrimStart().StartsWith("#") : false;

	string TypingTarget => SkipComments
		? string.Join("\n", DisplayCode.Split('\n').Where(l => !IsCommentLine(l)))
		: DisplayCode;

	string RenderDisplayCode()
	{
		var sb = new StringBuilder();
		var lines = DisplayCode.Split('\n');
		foreach (var line in lines)
		{
			var enc = System.Net.WebUtility.HtmlEncode(line);
			if (SkipComments && IsCommentLine(line))
				sb.Append($"<span class=\"comment-dim\">{enc}</span>\n");
			else
				sb.Append(enc + "\n");
		}
		return sb.ToString().TrimEnd('\n');
	}

	// ── Score & Timer ──
	DateTime? startTime;
	int HiScore;
	bool IsNewRecord;

	double ElapsedSeconds => startTime.HasValue ? (DateTime.Now - startTime.Value).TotalSeconds : 0;
	string Wpm => ElapsedSeconds > 1 ? ((int)((CorrectChars / 5.0) / (ElapsedSeconds / 60.0))).ToString() : "–";
	bool IsComplete => _typed.Length > 0 && _typed.Replace("\r\n","\n") == TypingTarget.Replace("\r\n","\n");

	int Score
	{
		get
		{
			if (TotalTyped == 0) return 0;
			double acc = (double)CorrectChars / Math.Max(1, TotalTyped);
			double wpmVal = ElapsedSeconds > 1 ? (CorrectChars / 5.0) / (ElapsedSeconds / 60.0) : 0;
			// WPM × 正確率² で速さより正確さを重視。完了ボーナス 300
			return (int)(wpmVal * acc * acc * 10 + (IsComplete ? 300 : 0));
		}
	}

	async Task UpdateScoreAsync()
	{
		if (TotalTyped == 0) return;
		var key = $"{selectedId}_{selectedLang}";
		bool newRec = await JS.InvokeAsync<bool>("setHiScore", key, Score);
		if (newRec)
		{
			HiScore = Score;
			IsNewRecord = true;
			StateHasChanged();
		}
	}

	async Task LoadHiScoreAsync()
	{
		var key = $"{selectedId}_{selectedLang}";
		HiScore = await JS.InvokeAsync<int>("getHiScore", key);
		IsNewRecord = false;
		StateHasChanged();
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await LoadHiScoreAsync();
			await JS.InvokeVoidAsync("htSetupTyping");
			await JS.InvokeVoidAsync("htUpdateTarget", TypingTarget);
		}
	}

	void ResetTyping()
	{
		_typed = string.Empty;
		startTime = null;
		IsNewRecord = false;
		_ = LoadHiScoreAsync();
		_ = JS.InvokeVoidAsync("htUpdateTarget", TypingTarget);
	}

	class Snippet
	{
		public string Title { get; set; }
		public string CSharp { get; set; }
		public string Python { get; set; }
		public string[] Explanations { get; set; }
		public string Description { get; set; } = "";
	}

	void ApplySample()
	{
		if (!string.IsNullOrEmpty(SampleText))
		{
			_displayOverride = SampleText.Replace("\r\n","\n");
			ResetTyping();
		}
	}

	void ClearSample()
	{
		_displayOverride = null;
		SampleText = string.Empty;
		ResetTyping();
	}

	private string? _displayOverride = null;

	string DisplayCode => _displayOverride ?? (SelectedLang == 1 ? Snippets[SelectedId].CSharp
						: SelectedLang == 2 ? Snippets[SelectedId].Python
						: string.Join("\n", Snippets[SelectedId].Explanations));

	Dictionary<int, Snippet> Snippets = new Dictionary<int, Snippet>
	{
		[1] = new Snippet
		{
			Title = "Binary Search",
			Description = "ソート済み配列を中央で分割しながら探索範囲を半分に絞る。計算量 O(log n)。前提: 配列がソート済みであること。left + (right-left)/2 でオーバーフローを防ぐ。",
			CSharp = "// 【二分探索】ソート済み配列を O(log n) で検索\n// 引数: ソート済み配列 a、探索対象 target\nint BinarySearch(int[] a, int target)\n{\n    // 探索範囲の左端・右端を初期化\n    int left = 0, right = a.Length - 1;\n    // 範囲が残る間ループ継続\n    while (left <= right)\n    {\n        // オーバーフロー防止: (left+right)/2 ではなくこちら\n        int mid = left + (right - left) / 2;\n        // 中央が一致 → インデックスを返す\n        if (a[mid] == target) return mid;\n        // target が右側 → 左端を中央の右へ移動\n        if (a[mid] < target) left = mid + 1;\n        // target が左側 → 右端を中央の左へ移動\n        else right = mid - 1;\n    }\n    // 見つからなければ -1 を返す\n    return -1;\n}",
			Python = "# 【二分探索】ソート済み配列を O(log n) で検索\n# 引数: ソート済み配列 a、探索対象 target\ndef binary_search(a, target):\n    # 探索範囲の左端・右端を初期化\n    left, right = 0, len(a)-1\n    # 範囲が残る間ループ継続\n    while left <= right:\n        # 中間位置を計算\n        mid = (left + right)//2\n        # 中央が一致 → インデックスを返す\n        if a[mid] == target:\n            return mid\n        # target が右側 → 左端を中央の右へ移動\n        if a[mid] < target:\n            left = mid + 1\n        # target が左側 → 右端を中央の左へ移動\n        else:\n            right = mid - 1\n    # 見つからなければ -1 を返す\n    return -1",
			Explanations = new[] { "ソート済み配列を中央で分割して探索", "O(log n)" }
		},

		[2] = new Snippet
		{
			Title = "Merge Sort",
			Description = "配列を半分に分割して再帰的にソートし、2つのソート済み配列をマージする。計算量 O(n log n)、空間 O(n)。安定ソートで大規模データに適する。",
			CSharp = "// 【マージソート】分割→再帰ソート→マージ O(n log n) 安定\nint[] MergeSort(int[] a)\n{\n    // 要素数1以下はすでに整列済み → ベースケース\n    if (a.Length <= 1) return a;\n    // 中間位置を計算\n    int mid = a.Length / 2;\n    // 左半分を再帰的にソート\n    int[] left = MergeSort(a[..mid]);\n    // 右半分を再帰的にソート\n    int[] right = MergeSort(a[mid..]);\n    // ソート済み2配列をマージして返す\n    return Merge(left, right);\n}\nint[] Merge(int[] l, int[] r)\n{\n    // 結果格納用の配列を用意\n    int[] res = new int[l.Length + r.Length];\n    int i = 0, j = 0, k = 0;\n    // 左右を比較しながら小さい方を結果に追加\n    while (i < l.Length && j < r.Length)\n        res[k++] = l[i] <= r[j] ? l[i++] : r[j++];\n    // 左側の残りを追加\n    while (i < l.Length) res[k++] = l[i++];\n    // 右側の残りを追加\n    while (j < r.Length) res[k++] = r[j++];\n    return res;\n}",
			Python = "# 【マージソート】分割→再帰ソート→マージ O(n log n) 安定\ndef merge_sort(a):\n    # 要素数1以下はすでに整列済み → ベースケース\n    if len(a) <= 1:\n        return a\n    # 中間位置を計算\n    mid = len(a) // 2\n    # 左半分を再帰的にソート\n    left = merge_sort(a[:mid])\n    # 右半分を再帰的にソート\n    right = merge_sort(a[mid:])\n    # ソート済み2配列をマージして返す\n    return merge(left, right)\ndef merge(l, r):\n    res = []\n    i = j = 0\n    # 左右を比較しながら小さい方を結果に追加\n    while i < len(l) and j < len(r):\n        if l[i] <= r[j]:\n            res.append(l[i]); i += 1\n        else:\n            res.append(r[j]); j += 1\n    # 残りを追加して返す\n    return res + l[i:] + r[j:]",
			Explanations = new[] { "分割して再帰ソート後マージ", "O(n log n) 安定" }
		},

		[3] = new Snippet
		{
			Title = "Quick Sort",
			Description = "ピボット要素を基準に小さい/大きいに分割して再帰的にソート。平均 O(n log n)、最悪 O(n²)。in-place で動作し実用的に高速。ピボット選択で性能が変わる。",
			CSharp = "// 【クイックソート】ピボット分割→再帰 平均 O(n log n)\nvoid QuickSort(int[] a, int lo, int hi)\n{\n    if (lo >= hi) return;\n    // ピボットで分割し位置を返す\n    int p = Partition(a, lo, hi);\n    QuickSort(a, lo, p - 1);\n    QuickSort(a, p + 1, hi);\n}\nint Partition(int[] a, int lo, int hi)\n{\n    // 末尾要素をピボットとして選択\n    int pivot = a[hi], i = lo;\n    for (int j = lo; j < hi; j++)\n        // pivot 以下なら左側グループへ交換\n        if (a[j] <= pivot) { (a[i], a[j]) = (a[j], a[i]); i++; }\n    // ピボットを正しい位置に置く\n    (a[i], a[hi]) = (a[hi], a[i]);\n    return i;\n}",
			Python = "# 【クイックソート】ピボット分割→再帰 平均 O(n log n)\ndef quick_sort(a, lo, hi):\n    if lo >= hi:\n        return\n    # ピボットで分割し位置を返す\n    p = partition(a, lo, hi)\n    quick_sort(a, lo, p - 1)\n    quick_sort(a, p + 1, hi)\ndef partition(a, lo, hi):\n    # 末尾要素をピボットとして選択\n    pivot = a[hi]\n    i = lo\n    for j in range(lo, hi):\n        # pivot 以下なら左側グループへ交換\n        if a[j] <= pivot:\n            a[i], a[j] = a[j], a[i]\n            i += 1\n    # ピボットを正しい位置に置く\n    a[i], a[hi] = a[hi], a[i]\n    return i",
			Explanations = new[] { "ピボット分割して再帰ソート", "平均 O(n log n)" }
		},

		[4] = new Snippet
		{
			Title = "Bubble Sort",
			Description = "隣接する要素を比較して大きい方を後ろに移動するパスを繰り返す。計算量 O(n²)。実装が最もシンプル。各パスで1つの最大値が末尾に確定する。",
			CSharp = "// 【バブルソート】隣接比較・交換を繰り返す O(n²)\nvoid BubbleSort(int[] a)\n{\n    // n 回パスを行う（毎回最大値が末尾に確定）\n    for (int i = 0; i < a.Length; i++)\n        // 各パスで末尾 i 個は確定済みなので範囲を縮小\n        for (int j = 0; j + 1 < a.Length - i; j++)\n            // 隣接要素が逆順なら交換\n            if (a[j] > a[j+1]) { var t = a[j]; a[j]=a[j+1]; a[j+1]=t; }\n}",
			Python = "# 【バブルソート】隣接比較・交換を繰り返す O(n²)\ndef bubble_sort(a):\n    n = len(a)\n    # n 回パスを行う（毎回最大値が末尾に確定）\n    for i in range(n):\n        # 各パスで末尾 i 個は確定済みなので範囲を縮小\n        for j in range(0, n-i-1):\n            # 隣接要素が逆順なら交換\n            if a[j] > a[j+1]:\n                a[j], a[j+1] = a[j+1], a[j]",
			Explanations = new[] { "隣接要素比較・交換", "O(n²)" }
		},

		[5] = new Snippet
		{
			Title = "Insertion Sort",
			Description = "左側を整列済みとして右から1要素ずつ取り出し適切な位置に挿入する。計算量 O(n²)。ほぼ整列済みデータに高速。安定ソート。小規模データや外部ライブラリでも内部で使われる。",
