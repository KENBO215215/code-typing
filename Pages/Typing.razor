@page "/typing"
@using System.Text
@inject IJSRuntime JS

<div class="page-header">
    <h2 class="page-title">⌨️ Code Typing Practice</h2>
    @if (IsComplete)
    {
        <div class="complete-badge">✅ Complete!</div>
    }
</div>

<div class="typing-container" style="--ok-color:@OkColor; --ng-color:@NgColor; --remain-color:@RemainColor;">
	<div class="left">
		<div class="controls">
            <div class="ctrl-row">
                <div class="ctrl-group">
                    <label class="ctrl-label">Algorithm</label>
                    <select @bind="SelectedId">
                        @foreach(var kv in Snippets)
                        {
                            <option value="@kv.Key">@kv.Value.Title</option>
                        }
                    </select>
                </div>
                <div class="ctrl-group">
                    <label class="ctrl-label">Language</label>
                    <select @bind="SelectedLang">
                        <option value="1">C#</option>
                        <option value="2">Python</option>
                        <option value="3">Exam Notes</option>
                    </select>
                </div>
                <button class="reset-btn" @onclick="ResetTyping" title="Reset">↺ Reset</button>
            </div>
            <div class="ctrl-row ctrl-row--colors">
                <label>✅ <input type="color" @bind="OkColor" /></label>
                <label>❌ <input type="color" @bind="NgColor" /></label>
                <label>… <input type="color" @bind="RemainColor" /></label>
            </div>
		</div>

		<div class="code-block code-explain-grid">
			<div class="code-col"><pre>@(DisplayCode)</pre></div>
			<div class="explain-col">
				@foreach(var ex in GetLineExplanations())
				{
					<div class="line-explain">@ex</div>
				}
			</div>
		</div>
		<div class="explain">
			@foreach (var line in CurrentExplanations)
			{
				<div>@line</div>
			}
		</div>

		<div class="sample-box">
			<label>Paste your sample (will replace code when applied):</label>
			<textarea @bind="SampleText" rows="6" placeholder="Paste code here..."></textarea>
			<div>
				<button @onclick="ApplySample">Use as sample</button>
				<button @onclick="ClearSample" style="margin-left:8px">Clear sample</button>
			</div>
		</div>
	</div>

	<div class="right">
		<div id="type-window" class="type-window">
			<div class="drag-handle">Type Window</div>
			<div class="type-area" style="position:relative;">
				<pre id="overlay" class="overlay">@((MarkupString)RenderComparison())</pre>
				<textarea id="type-textarea" @bind="Typed" @bind:event="oninput" rows="15" placeholder="Type the code here..." spellcheck="false" autocapitalize="off" autocomplete="off"></textarea>
			</div>
		</div>
@* Script for dragging the type-window *@
<script>
	(function(){
		const win = document.getElementById('type-window');
		if (!win) return;
		const handle = win.querySelector('.drag-handle');
		if (!handle) return;
		let dragging = false, startX=0, startY=0, origX=0, origY=0;
		handle.addEventListener('mousedown', (e)=>{
			dragging = true; startX = e.clientX; startY = e.clientY;
			const rect = win.getBoundingClientRect(); origX = rect.left; origY = rect.top;
			win.style.position = 'absolute'; win.style.zIndex = 9999;
			e.preventDefault();
		});
		window.addEventListener('mousemove', (e)=>{
			if(!dragging) return;
			const dx = e.clientX - startX; const dy = e.clientY - startY;
			win.style.left = (origX + dx) + 'px'; win.style.top = (origY + dy) + 'px';
		});
		window.addEventListener('mouseup', ()=>{ dragging = false; });
		// touch support
		handle.addEventListener('touchstart', (e)=>{
			const t = e.touches[0];
			dragging = true; startX = t.clientX; startY = t.clientY;
			const rect = win.getBoundingClientRect(); origX = rect.left; origY = rect.top;
			win.style.position = 'absolute'; win.style.zIndex = 9999;
			e.preventDefault();
		}, {passive:false});
		window.addEventListener('touchmove',(e)=>{
			if(!dragging) return;
			const t = e.touches[0];
			const dx = t.clientX - startX; const dy = t.clientY - startY;
			win.style.left = (origX + dx) + 'px'; win.style.top = (origY + dy) + 'px';
		}, {passive:false});
		window.addEventListener('touchend', ()=>{ dragging = false; });

		// sync overlay scroll and focus handling
		const ta = document.getElementById('type-textarea');
		const overlay = document.getElementById('overlay');
		if (ta && overlay) {
			// sync on scroll/input
			ta.addEventListener('scroll', ()=> { overlay.scrollTop = ta.scrollTop; });
			ta.addEventListener('input', ()=> { overlay.scrollTop = ta.scrollTop; });
			// composition events for IME: update overlay during composition
			ta.addEventListener('compositionstart', ()=> { /* no-op: Blazor already updates oninput after compositionend */ });
			ta.addEventListener('compositionend', ()=> { overlay.scrollTop = ta.scrollTop; });
			// clicking the window focuses textarea
			win.addEventListener('click', (e)=>{ if (e.target !== ta) { ta.focus(); } });
		}
		// keyboard highlighting
		const kb = document.getElementById('onScreenKeyboard');
		if (ta && kb) {
			const keyDown = (e)=>{
				const k = (e.key === ' ') ? 'Space' : e.key;
				const el = kb.querySelector(`[data-key="${k}"]`) || kb.querySelector(`[data-key="${k.toLowerCase()}"]`);
				if (el) el.classList.add('active');
			};
			const keyUp = (e)=>{
				const k = (e.key === ' ') ? 'Space' : e.key;
				const el = kb.querySelector(`[data-key="${k}"]`) || kb.querySelector(`[data-key="${k.toLowerCase()}"]`);
				if (el) el.classList.remove('active');
			};
			window.addEventListener('keydown', keyDown);
			window.addEventListener('keyup', keyUp);
		}
	})();
</script>

